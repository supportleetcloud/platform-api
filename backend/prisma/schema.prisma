generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Session store table for `connect-pg-simple`. The library queries these exact lowercase
/// identifiers directly (see node_modules/connect-pg-simple/table.sql), so the @map names
/// and column types must not change. It's modelled here — rather than left to
/// createTableIfMissing — so it lives inside Prisma's migration history and `prisma migrate
/// dev` doesn't treat it as drift and drop it. Nothing in application code reads it via Prisma.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model User {
  id        String   @id @default(uuid())
  githubId  String   @unique
  username  String
  avatarUrl String?
  isAdmin   Boolean  @default(false)
  isPaid    Boolean  @default(false)
  hideFromRanking Boolean @default(false)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs           Run[]
  tosAcceptances TosAcceptance[]
}

model Challenge {
  id               String   @id @default(uuid())
  title            String
  description      String?  @db.Text
  objective        String?  @db.Text
  technicalDetails String?  @db.Text
  // Freeform, matches whatever the YAML's top-level `category:` field says
  // (crud, contract, status, auth in the fixtures below) — no enum enforced.
  category         String
  points           Int
  // Null means this challenge is defined in the database (ChallengeCheck rows below),
  // not a file under backend/challenges/ — see runs/service.ts's YAML-loading branch.
  yamlPath         String?
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  runs   Run[]
  checks ChallengeCheck[]
}

model Run {
  id            String   @id @default(uuid())
  userId        String
  challengeId   String
  targetUrl     String
  status        String   @default("pending")
  score         Int?
  checks        Json?
  error         String?
  callbackToken String
  feedback      String?
  feedbackStatus String   @default("not_applicable")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@index([userId, challengeId])
}

model LlmSettings {
  id              String   @id
  provider        String
  model           String
  baseUrl         String?
  apiKeyEncrypted String?
  updatedAt       DateTime @updatedAt
}

model TosVersion {
  id          String   @id @default(uuid())
  content     String   @db.Text
  publishedAt DateTime @default(now())

  acceptances TosAcceptance[]
}

model TosAcceptance {
  id           String   @id @default(uuid())
  userId       String
  tosVersionId String
  acceptedAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  tosVersion TosVersion @relation(fields: [tosVersionId], references: [id])

  @@unique([userId, tosVersionId])
}

model BillingSettings {
  id              String   @id
  stripeProductId String
  stripePriceId   String
  amountCents     Int
  currency        String   @default("usd")
  updatedAt       DateTime @updatedAt
}

model ChallengeCheck {
  id             String  @id @default(uuid())
  challengeId    String
  name           String
  method         String
  path           String
  requestHeaders Json?
  requestBody    Json?
  expectStatus   Int
  expectJson     Json?
  expectHeaders  Json?
  points         Int
  order          Int

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}
