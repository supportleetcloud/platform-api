<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.practiceplatform</groupId>
    <artifactId>validation-engine</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <!-- Originally bumped for com.networknt:json-schema-validator:3.0.6 (Task 9), which pulled in
             tools.jackson.core:jackson-databind:3.1.4, built against com.fasterxml.jackson.core:jackson-annotations:2.21
             (e.g. the JsonSerializeAs class) - older than spring-boot-starter-parent:3.3.5's default 2.17.2 pin,
             causing a NoClassDefFoundError at runtime. Task 10 downgraded json-schema-validator to 2.0.1 (see
             below), which no longer needs this, but the bump is harmless/beneficial (a newer, still-2.x-compatible
             patch line) so it is kept rather than churned back down. -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <!-- Pinned to 2.0.1, not the latest 3.0.6, because com.atlassian.oai:swagger-request-validator-core:3.0.0
                 (below) internally calls com.networknt.schema.SchemaRegistry.getSchema(JsonNode) compiled against
                 json-schema-validator 2.0.1's API, which still uses com.fasterxml.jackson.databind.JsonNode (classic
                 Jackson 2.x). json-schema-validator 3.0.6 renamed its internal JsonNode type to
                 tools.jackson.databind.JsonNode (an unrelated Jackson-3-family type), so with 3.0.6 on the classpath
                 swagger-request-validator-core throws NoSuchMethodError at runtime (Maven can only put one version
                 of json-schema-validator on the classpath; the directly-declared version here always wins over the
                 transitive one). 2.0.1 already has the same SchemaRegistry/SpecificationVersion/InputFormat/Error
                 API that JsonSchemaAssertion (Task 9) uses, so downgrading required zero changes to
                 JsonSchemaAssertion.java - confirmed by re-running JsonSchemaAssertionTest and the full suite. -->
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-core</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
